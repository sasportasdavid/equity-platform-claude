# =============================================================================
# Capiwise — Equity Platform — Environment variables example
# =============================================================================
# Copie ce fichier en `apps/web/.env.local` (gitignored) et remplis les valeurs.
# Ne JAMAIS committer .env, .env.local ou tout fichier contenant des secrets.
# =============================================================================

# --- Next.js -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon / publishable key (public, safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SECRET, server-side only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Python Quant Engine (existing service on Fly.io) ------------------------
QUANT_ENGINE_URL=https://equity-gem-quant.fly.dev
QUANT_ENGINE_API_KEY=

# --- Yousign (e-signature) ---------------------------------------------------
# API key — récupérée dans le Dashboard Yousign (Settings → API)
YOUSIGN_API_KEY=
# Sandbox: https://api-sandbox.yousign.app/v3 — Production: https://api.yousign.app/v3
YOUSIGN_API_BASE_URL=https://api-sandbox.yousign.app/v3
# Secret HMAC SHA-256 partagé avec Yousign Dashboard (Webhooks).
# Doit être identique côté Yousign Dashboard et côté Edge Function (supabase secrets)
YOUSIGN_WEBHOOK_SECRET=
# 'sandbox' ou 'production' — tracé dans signature_requests.yousign_environment
YOUSIGN_ENVIRONMENT=sandbox

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@capiwise.fr
RESEND_WEBHOOK_SECRET=

# --- EODHD (market data — optional, may already be handled by Python engine) -
EODHD_API_KEY=

# --- Sentry (V2) -------------------------------------------------------------
SENTRY_DSN=
